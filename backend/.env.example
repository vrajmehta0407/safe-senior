# Safe Senior Backend — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

DATABASE_URL=postgresql://user:password@host:5432/safesenior

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars

PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ── Email OTP (Gmail SMTP) ───────────────────────────────────────────────────
# Use a Gmail App Password (Google Account → Security → App Passwords).
# Set SMTP_USER=mock to skip real email in dev (OTP prints to console).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="Safe Senior <your_gmail@gmail.com>"

# ── Admin Panel (keep ALL of these out of version control) ──────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=change_me_to_long_random_string_min_48_chars

# Generate your own — keep this value secret, do NOT publish:
# node -e "console.log('/api/ops-' + require('crypto').randomBytes(4).toString('hex'))"
ADMIN_ROUTE_PREFIX=/api/ops-GENERATE_YOUR_OWN

# Origin allowed to call the admin API (your admin panel URL). Leave blank in dev.
ADMIN_ALLOWED_ORIGIN=http://localhost:5173

# Comma-separated IPs/CIDRs allowed to reach admin routes. Leave blank to disable.
ADMIN_IP_ALLOWLIST=

# Set to true once you have confirmed TOTP setup in your authenticator app.
ADMIN_2FA_REQUIRED=false

# ── FCM Push Notifications (optional) ───────────────────────────────────────
# Set ONE of these to enable real push delivery. Leave both blank for dev (no-op).
# Path to your Firebase service account JSON file:
FCM_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# OR paste the entire JSON as a single-line string:
FCM_SERVICE_ACCOUNT_JSON=

# ── Android SMS Gateway (sms-gate.app) ──────────────────────────────────────
# Install the free 'SMS Gate' app on an Android phone.
# Mode options:
#   cloud  → api.sms-gate.app (phone needs internet, use app Cloud server creds)
#   local  → talk directly to phone on LAN (faster, no internet needed)
#   mock   → OTP prints to console only (safe for dev)
#   off    → disable SMS entirely (email OTP only)
SMS_GW_MODE=cloud
SMS_GW_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GW_USERNAME=your_sms_gate_username
SMS_GW_PASSWORD=your_sms_gate_password
# Optional: pin messages to a specific device
SMS_GW_DEVICE_ID=your_device_id

# ── Android SMS Gateway (https://github.com/capcom6/android-sms-gateway) ─────
# Install the free Android app on any Android phone → it becomes an SMS gateway.
#
# SMS_GW_MODE options:
#   mock  → no SMS sent; OTP is printed to server console  (default/dev)
#   cloud → uses the managed api.sms-gate.app cloud relay  (create free account)
#   local → direct HTTP to the Android device on your LAN  (no internet needed)
#   off   → SMS disabled entirely; OTP delivered via email only
#
SMS_GW_MODE=mock
#
# Cloud mode — create account at https://sms-gate.app, then:
#   SMS_GW_URL=https://api.sms-gate.app/3rdparty/v1  (this is the default)
#
# Local mode — find the device IP & port in the app's main screen:
#   SMS_GW_URL=http://192.168.1.XXX:8080
#
SMS_GW_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GW_USERNAME=your_smsgate_username
SMS_GW_PASSWORD=your_smsgate_password
